{
  "name": "groulevel",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Groulevel — comparador y marketplace de formación tecnológica (MVP)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.api.json && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "data:import": "python3 scripts/import_xlsx.py"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vercel/node": "^20.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
