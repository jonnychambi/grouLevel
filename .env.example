# Subdirectorio de publicación (GitHub Pages de proyecto). Con dominio propio: "/"
BASE_PATH=/
# URL pública absoluta (canonical, Open Graph, sitemap)
VITE_SITE_URL=https://www.groulevel.com
# Opcionales — si se definen, reemplazan las implementaciones locales sin tocar la UI
# VITE_DATA_API_URL=https://api.groulevel.com/v1
# VITE_LEAD_API_URL=https://api.groulevel.com/v1/leads
# VITE_PARTNER_API_URL=https://api.groulevel.com/v1/partners

# Google Analytics 4 (Consent Mode v2). En Vercel solo en Production.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Servidor (Vercel → Environment Variables, nunca en el código):
# BLOB_READ_WRITE_TOKEN   lo crea el Blob store conectado al proyecto
# ADMIN_PASSWORD          contraseña de /admin
# ADMIN_SESSION_SECRET    firma de las sesiones del administrador
# LEAD_WEBHOOK_URL        (opcional) reenvía cada lead a Zapier/Make/CRM

# Mi ruta: análisis de CV con Claude (opcional; sin clave se usa el motor por reglas)
ANTHROPIC_API_KEY=
# PROFILE_AI_MODEL=claude-opus-5-5

# Base de datos (Supabase vía Vercel Marketplace; se crean solas al conectar la integración)
# POSTGRES_URL=postgres://…pooler.supabase.com:6543/postgres
# POSTGRES_URL_NON_POOLING=postgres://…pooler.supabase.com:5432/postgres
# MIGRATE=1            fuerza migraciones en builds que no son de producción
# MIGRATE_STRICT=1     hace fallar el build si una migración falla
