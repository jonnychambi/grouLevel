{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "groulevel.com"
        }
      ],
      "destination": "https://www.groulevel.com/:path",
      "permanent": true
    },
    {
      "source": "/recompensas",
      "destination": "/rewards",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap-build.xml",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/_shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/mi-ruta/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-src 'none'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path+",
      "destination": "/admin"
    },
    {
      "source": "/mi-ruta/:id",
      "destination": "/mi-ruta"
    },
    {
      "source": "/",
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/programas",
      "destination": "/api/seo?path=/programas"
    },
    {
      "source": "/programas/:slug",
      "destination": "/api/seo?path=/programas/:slug"
    },
    {
      "source": "/programa/:slug",
      "destination": "/api/seo?path=/programa/:slug"
    },
    {
      "source": "/instituciones",
      "destination": "/api/seo?path=/instituciones"
    },
    {
      "source": "/institucion/:slug",
      "destination": "/api/seo?path=/institucion/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?sitemap=1"
    },
    {
      "source": "/programa/:slug/opiniones",
      "destination": "/api/seo?path=/programa/:slug/opiniones"
    },
    {
      "source": "/institucion/:slug/opiniones",
      "destination": "/api/seo?path=/institucion/:slug/opiniones"
    },
    {
      "source": "/carreras",
      "destination": "/api/seo?path=/carreras"
    },
    {
      "source": "/carreras/:slug",
      "destination": "/api/seo?path=/carreras/:slug"
    },
    {
      "source": "/habilidades",
      "destination": "/api/seo?path=/habilidades"
    },
    {
      "source": "/habilidades/:slug",
      "destination": "/api/seo?path=/habilidades/:slug"
    },
    {
      "source": "/cursos",
      "destination": "/api/seo?path=/cursos"
    },
    {
      "source": "/cursos/:slug",
      "destination": "/api/seo?path=/cursos/:slug"
    },
    {
      "source": "/diplomados",
      "destination": "/api/seo?path=/diplomados"
    },
    {
      "source": "/diplomados/:slug",
      "destination": "/api/seo?path=/diplomados/:slug"
    },
    {
      "source": "/bootcamps",
      "destination": "/api/seo?path=/bootcamps"
    },
    {
      "source": "/bootcamps/:slug",
      "destination": "/api/seo?path=/bootcamps/:slug"
    },
    {
      "source": "/maestrias",
      "destination": "/api/seo?path=/maestrias"
    },
    {
      "source": "/maestrias/:slug",
      "destination": "/api/seo?path=/maestrias/:slug"
    },
    {
      "source": "/especializaciones",
      "destination": "/api/seo?path=/especializaciones"
    },
    {
      "source": "/especializaciones/:slug",
      "destination": "/api/seo?path=/especializaciones/:slug"
    },
    {
      "source": "/guias",
      "destination": "/api/seo?path=/guias"
    },
    {
      "source": "/guias/:slug",
      "destination": "/api/seo?path=/guias/:slug"
    },
    {
      "source": "/comparar/:slug",
      "destination": "/api/seo?path=/comparar/:slug"
    },
    {
      "source": "/analizar-perfil",
      "destination": "/api/seo?path=/analizar-perfil"
    }
  ],
  "functions": {
    "api/profile.ts": {
      "maxDuration": 300
    },
    "api/admin.ts": {
      "maxDuration": 300,
      "includeFiles": "src/data/*.json"
    },
    "api/cron.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
