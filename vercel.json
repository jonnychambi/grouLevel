{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": [
    "gru1"
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "groulevel.com"
        }
      ],
      "destination": "https://www.groulevel.com/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_shell.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/mi-ruta/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/admin(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/admin/:path+",
      "destination": "/admin"
    },
    {
      "source": "/mi-ruta/:id",
      "destination": "/mi-ruta"
    },
    {
      "source": "/",
      "destination": "/api/seo?path=/"
    },
    {
      "source": "/programas",
      "destination": "/api/seo?path=/programas"
    },
    {
      "source": "/programas/:slug",
      "destination": "/api/seo?path=/programas/:slug"
    },
    {
      "source": "/programa/:slug",
      "destination": "/api/seo?path=/programa/:slug"
    },
    {
      "source": "/instituciones",
      "destination": "/api/seo?path=/instituciones"
    },
    {
      "source": "/institucion/:slug",
      "destination": "/api/seo?path=/institucion/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?sitemap=1"
    }
  ],
  "functions": {
    "api/profile.ts": {
      "maxDuration": 300
    },
    "api/admin.ts": {
      "maxDuration": 300
    },
    "api/cron.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 9 * * *"
    }
  ]
}
